        <mxCell id="p2-phu-de" parent="p2-1" vertex="1" value="Điều hướng tìm dịch vụ, đặt chỗ, quản lý tài khoản và theo dõi đơn · 28/11/2026" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=6;fontSize=14;fontColor=#475569;">
          <mxGeometry x="40" y="100" width="2430" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-cach-doc" parent="p2-1" vertex="1" value="&lt;b&gt;Cách đọc&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#E0F2FE;color:#0369A1&quot;&gt;&lt;b&gt;&amp;nbsp;Xanh dương · Website&amp;nbsp;&lt;/b&gt;&lt;/span&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;background:#F3E8FF;color:#7E22CE&quot;&gt;&lt;b&gt;&amp;nbsp;Tím · Quản trị&amp;nbsp;&lt;/b&gt;&lt;/span&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;background:#FFFFFF;color:#475569&quot;&gt;&lt;b&gt;&amp;nbsp;Trắng · Tác nhân, màn lỗi hoặc hệ thống ngoài&amp;nbsp;&lt;/b&gt;&lt;/span&gt; &amp;nbsp;·&amp;nbsp; &lt;b&gt;Vàng · Ghi chú&lt;/b&gt; &amp;nbsp;|&amp;nbsp; Đọc theo chiều mũi tên. Nét liền chỉ thao tác thông thường. Nét đứt chỉ nhánh điều kiện, hộp thoại hoặc liên kết chưa có trang. Viền dày yêu cầu đăng nhập." style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=6;strokeWidth=1.5;fillColor=#FEF3C7;strokeColor=#B45309;">

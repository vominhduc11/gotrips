        <mxCell id="p2-chi-tiet-don" parent="p2-1" vertex="1" value="&lt;b style=&quot;font-size:15px&quot;&gt;Chi tiết đơn đặt chỗ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;color:#0369A1&quot;&gt;/bookings/[code]&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#475569&quot;&gt;Cần đăng nhập&lt;/b&gt;&lt;br&gt;Đọc trạng thái đơn và thanh toán&lt;br&gt;Xem dịch vụ và người đi, người nhận phòng&lt;br&gt;Xem hướng dẫn chuyển khoản khi chờ thanh toán&lt;br&gt;Mã VietQR nếu có · Tự cập nhật khi nhận tiền" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=12;align=left;spacing=8;spacingLeft=6;verticalAlign=middle;strokeWidth=2;fillColor=#E0F2FE;strokeColor=#0369A1;">

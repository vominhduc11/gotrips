        <mxCell id="p2-login" parent="p2-1" vertex="1" value="&lt;b style=&quot;font-size:15px&quot;&gt;Đăng nhập&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;color:#0369A1&quot;&gt;/login?next=…&lt;/span&gt;&lt;br&gt;Đăng nhập xong mở đường dẫn nội bộ trong next&lt;br&gt;Về Trang chủ nếu thiếu next hợp lệ" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=12;align=left;spacing=8;spacingLeft=6;verticalAlign=middle;strokeWidth=1.5;fillColor=#E0F2FE;strokeColor=#0369A1;">

        <mxCell id="p2-dau-trang" parent="p2-khung-chung" vertex="1" value="&lt;b&gt;Đầu trang và menu di động&lt;/b&gt;&lt;br&gt;Trang chủ (/) · Tour du lịch (/tours) · Điểm đến (/destinations) · Khách sạn (/hotels) · Vé máy bay (/flights)" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=6;strokeWidth=1.5;fillColor=#E0F2FE;strokeColor=#0369A1;">

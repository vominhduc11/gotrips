        <mxCell id="p3-khung" parent="p3-1" vertex="1" value="&lt;b style=&quot;font-size:15px&quot;&gt;Khung quản trị&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#475569&quot;&gt;Cần đăng nhập · STAFF hoặc ADMIN&lt;/b&gt;&lt;br&gt;Thanh bên, đường dẫn điều hướng,&lt;br&gt;menu tài khoản và nội dung theo route" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=12;align=left;spacing=8;spacingLeft=6;verticalAlign=middle;strokeWidth=2;fillColor=#F3E8FF;strokeColor=#7E22CE;">

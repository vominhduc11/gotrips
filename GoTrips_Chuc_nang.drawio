        </mxCell>
        <mxCell id="p2-register" parent="p2-1" vertex="1" value="&lt;b style=&quot;font-size:15px&quot;&gt;Đăng ký&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;color:#0369A1&quot;&gt;/register&lt;/span&gt;&lt;br&gt;Tạo tài khoản CUSTOMER" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=12;align=left;spacing=8;spacingLeft=6;verticalAlign=middle;strokeWidth=1.5;fillColor=#E0F2FE;strokeColor=#0369A1;">
          <mxGeometry x="2030" y="1640" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-diem-can-nho" parent="p2-1" vertex="1" value="&lt;b&gt;Điểm cần nhớ&lt;/b&gt;&lt;br&gt;Chọn chuyến hoặc phòng ở trang chi tiết, chọn vé ở trang kết quả. Trang đặt dùng để nhập thông tin và xác nhận.&lt;br&gt;Bộ lọc và lựa chọn lưu trên URL. Bước mặc định là Thông tin (thong-tin), bước Xác nhận có step=xac-nhan. Thông tin cá nhân nằm trong biểu mẫu.&lt;br&gt;Cả ba form đặt chỗ điền sẵn số người liên hệ từ hồ sơ khi có. Khách có thể sửa số riêng cho từng đơn.&lt;br&gt;Khi liên kết đặt chỗ hợp lệ cần đăng nhập, next giữ đúng trang đặt và lựa chọn. Phiên hết hạn khi gửi đơn cũng quay về đăng nhập.&lt;br&gt;Khách theo dõi trạng thái ở /bookings/[code]. Khi bật SePay, đủ tiền thì đơn tự xác nhận nếu dịch vụ chưa bắt đầu; còn lại nhân viên xác nhận trong trang quản trị." style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=6;strokeWidth=1.5;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="40" y="1530" width="1750" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-lien-ket-chua-co" parent="p2-1" vertex="1" value="&lt;b&gt;Liên kết chưa có trang&lt;/b&gt;&lt;br&gt;Các liên kết ở chân trang dẫn tới trang 404.&lt;br&gt;/about · /news · /careers · /contact · /help&lt;br&gt;/help/how-to-book · /help/cancellation · /faq · /terms · /privacy" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=6;strokeWidth=1.5;dashed=1;dashPattern=6 4;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="40" y="1700" width="1750" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p2-diem-den" parent="p2-1" vertex="1" value="&lt;b&gt;Điểm đến&lt;/b&gt;&lt;br&gt;Điểm đến không có trạng thái.&lt;br&gt;DELETE /admin/destinations/{id}&lt;br&gt;Còn tour hoặc khách sạn tham chiếu ở bất kỳ trạng thái nào thì trả 409." style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=0;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;">
          <mxGeometry x="2070" y="630" width="330" height="210" as="geometry" />

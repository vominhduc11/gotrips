        <mxCell id="p3-st-sold-out" parent="p3-1" vertex="1" value="&lt;b&gt;Hết chỗ&lt;/b&gt;&lt;br&gt;SOLD_OUT&lt;br&gt;(tính ra)&lt;br&gt;Website: Hết chỗ&lt;br&gt;Admin: Hết chỗ" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=20;spacing=6;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#E5E7EB;strokeColor=#6B7280;dashed=1;dashPattern=6 4;">

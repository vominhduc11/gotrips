        <mxCell id="p4-bay-tr-thieu" parent="p4-1" edge="1" source="p4-bay-du" target="p4-bay-thieu" value="[Bay hôm nay hoặc thiếu ghế]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.6;fontSize=13;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;">

        <mxCell id="p3-tr-create" parent="p3-1" edge="1" source="p3-bat-dau" target="p3-st-upcoming" value="Nhân viên · tạo chuyến&lt;br&gt;[Ngày từ mai, tour chưa xoá, ngày chưa trùng]&lt;br&gt;POST /admin/tours/{id}/departures" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.6;fontSize=13;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;">

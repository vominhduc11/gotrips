  <diagram id="p3-trang" name="03 · Trạng thái chuyến khởi hành">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2440" pageHeight="2590" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />
        <mxCell id="p3-tieu-de" parent="p3-1" vertex="1" value="&lt;b&gt;GoTrips · Trạng thái chuyến khởi hành&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;">
          <mxGeometry x="40" y="20" width="2360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-phu-de" parent="p3-1" vertex="1" value="Từ lịch mở bán đến hết chỗ, đóng bán, đã qua hoặc xoá · 28/11/2026" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#475569;">
          <mxGeometry x="40" y="120" width="2360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-cach-doc" parent="p3-1" vertex="1" value="&lt;b&gt;Cách đọc&lt;/b&gt;&lt;br&gt;● Bắt đầu  ·  ◉ Kết thúc  ·  Hộp bo góc viền liền: trạng thái lưu  ·  Hộp bo góc viền đứt: trạng thái tính ra  ·  ◇ Rẽ nhánh, đọc điều kiện trên mũi tên ra&lt;br&gt;→ Chuyển hiện có  ·  ⋯→ Tự động theo ngày  ·  – – → Nét đứt xám: Chưa có  ·  Vàng: đang chờ  ·  Xanh lá: đang hoạt động  ·  Xám: tạm ẩn, đóng bán, hết chỗ  ·  Đỏ: đã huỷ, đã xoá, đã qua" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=0;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;">
          <mxGeometry x="40" y="210" width="2360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-luu" parent="p3-1" vertex="1" value="&lt;b&gt;Lưu ở đâu&lt;/b&gt;&lt;br&gt;tour_departures lưu các cột dùng để tính trạng thái: departure_date, sales_closed, booked_seats, total_seats.&lt;br&gt;state, editable, dateEditable, deletable, isAlmostFull và isSoldOut đều được tính. tour_bookings ghi lịch sử tham chiếu chuyến." style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=0;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;">
          <mxGeometry x="40" y="350" width="2360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-thu-tu" parent="p3-1" vertex="1" value="&lt;b&gt;Thứ tự ưu tiên khi tính · PAST &amp;gt; CLOSED &amp;gt; SOLD_OUT &amp;gt; UPCOMING&lt;/b&gt;&lt;br&gt;Ngày khởi hành ≤ hôm nay → PAST. Nếu còn trong tương lai: sales_closed → CLOSED; nếu vẫn mở và booked_seats ≥ total_seats → SOLD_OUT; còn lại → UPCOMING.&lt;br&gt;Hôm nay đã là PAST theo ngày Việt Nam. Kết quả tính lại khi đọc dữ liệu theo ngày hiện tại." style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=0;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;">
          <mxGeometry x="40" y="510" width="2360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-chinh" parent="p3-1" vertex="1" value="&lt;b&gt;Chuyến khởi hành · website và admin&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;">
          <mxGeometry x="40" y="670" width="2360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-bat-dau" parent="p3-1" vertex="1" value="" style="ellipse;shape=startState;html=1;aspect=fixed;fillColor=#0F172A;strokeColor=#0F172A;">
          <mxGeometry x="40" y="940" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-st-upcoming" parent="p3-1" vertex="1" value="&lt;b&gt;Đang mở bán&lt;/b&gt;&lt;br&gt;UPCOMING&lt;br&gt;(tính ra)&lt;br&gt;Website: chọn được nếu đủ chỗ&lt;br&gt;Admin: Sắp tới" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=20;spacing=6;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#DCFCE7;strokeColor=#15803D;dashed=1;dashPattern=6 4;">
          <mxGeometry x="380" y="900" width="270" height="110" as="geometry" />

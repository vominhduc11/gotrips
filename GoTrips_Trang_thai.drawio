          </mxGeometry>
        </mxCell>
        <mxCell id="p3-tr-reduce" parent="p3-1" edge="1" source="p3-st-upcoming" target="p3-st-sold-out" value="Nhân viên · giảm tổng chỗ&lt;br&gt;[total_seats bằng booked_seats &amp;gt; 0]&lt;br&gt;PUT /admin/departures/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.6;fontSize=13;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=1;exitY=0.48;exitPerimeter=0;entryX=0;entryY=0.48;entryPerimeter=0;">

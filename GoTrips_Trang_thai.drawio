        <mxCell id="p1-tt-paid-tr" parent="p1-1" edge="1" source="p1-tt-unpaid" target="p1-tt-paid" value="Ghi nhận&lt;br&gt;đủ tiền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.6;fontSize=13;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;">

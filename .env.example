# Copy file này thành ".env" rồi điền giá trị thật (KHÔNG commit .env)
POSTGRES_DB=gotrips
POSTGRES_USER=gotrips
POSTGRES_PASSWORD=change-me

# Khoá ký JWT đăng nhập của gotrips-api (bắt buộc, tối thiểu 32 ký tự, KHÔNG dùng lại giữa các môi trường).
# Tạo khoá: openssl rand -base64 48
GOTRIPS_JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
GOTRIPS_JWT_ADMIN_EXPIRATION=8h
# Chỉ đặt false cho HTTP local. Đặt true khi chạy trên HTTPS.
GOTRIPS_ADMIN_COOKIE_SECURE=false

# Profile Spring của gotrips-api. `seed` nạp dữ liệu mẫu (điểm đến, tour, khách sạn, chặng bay, lịch bay...) để chạy
# dev/Docker. Môi trường THẬT phải đặt rỗng (SPRING_PROFILES_ACTIVE=) để không nạp dữ liệu mẫu.
# Bỏ dòng này thì docker-compose mặc định dùng `seed`. Muốn nạp lại seed đã sửa: docker compose down -v
SPRING_PROFILES_ACTIVE=seed

# Tài khoản nhận chuyển khoản hiển thị trong đơn đặt chỗ. Profile `seed` đã có tài khoản THỬ NGHIỆM nên dev không cần
# đặt. Môi trường THẬT (SPRING_PROFILES_ACTIVE rỗng) BẮT BUỘC đặt cả ba, thiếu thì API không khởi động.
# GOTRIPS_BANK_NAME=
# GOTRIPS_BANK_ACCOUNT_NUMBER=
# GOTRIPS_BANK_ACCOUNT_NAME=

# Nguồn ảnh danh mục mà trang quản trị được lưu (nhiều tiền tố cách nhau bằng dấu phẩy). Bỏ trống dòng này thì dùng
# mặc định https://images.unsplash.com/photo-. Đổi ở đây thì phải đổi images.remotePatterns (gotrips-web/next.config.ts)
# và img-src (gotrips-admin/nginx.conf).
# GOTRIPS_CATALOG_ALLOWED_IMAGE_PREFIXES=

# Bật làm mới danh mục website sau khi admin huỷ đơn hoặc sửa danh mục. Điền cùng một bí mật cho API và web.
# Tạo bí mật bằng openssl rand -hex 32. Để URL trống nếu không bật.
# GOTRIPS_WEB_REVALIDATE_URL=http://gotrips-web:3000/api/revalidate
# GOTRIPS_REVALIDATE_SECRET=

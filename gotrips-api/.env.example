# Biến môi trường cho API chạy ngoài Compose. Nạp vào shell hoặc IDE trước khi chạy.
GOTRIPS_JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
GOTRIPS_JWT_ADMIN_EXPIRATION=8h
# Chỉ đặt false cho HTTP local. Mặc định API là true.
GOTRIPS_ADMIN_COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=seed

# Thanh toán qua SePay (tuỳ chọn). Secret Key HMAC-SHA256 trùng với khoá đặt ở webhook SePay; để trống thì tắt nhận
# webhook POST /payments/sepay/webhook. Tạo khoá: openssl rand -hex 32
# GOTRIPS_SEPAY_WEBHOOK_SECRET=
# Mã ngân hàng cho ảnh VietQR ở trang đơn (ví dụ VCB, MB hoặc mã BIN 970436); để trống thì không hiện mã QR.
# GOTRIPS_BANK_QR_CODE=

# Nguồn ảnh danh mục được phép; để nguyên chú thích thì dùng mặc định https://images.unsplash.com/photo-.
# GOTRIPS_CATALOG_ALLOWED_IMAGE_PREFIXES=

# Webhook làm mới cache danh mục; dùng cùng giá trị ở API và web.
# GOTRIPS_REVALIDATE_SECRET=
# Để trống nếu không bật. Khi chạy API ngoài Docker, dùng địa chỉ web từ máy này.
# GOTRIPS_WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

        <mxCell id="p1-ngan-hang" parent="p1-1" vertex="1" value="&lt;b&gt;Ngân hàng và SePay · Ngoài hệ thống&lt;/b&gt;&lt;br&gt;Khách chuyển khoản, nội dung là mã đơn. Trang đơn có thể hiện ảnh VietQR.&lt;br&gt;SePay báo tiền vào, API tự ghi nhận vào đơn theo mã đơn.&lt;br&gt;Giao dịch lệch hoặc khi tắt SePay: nhân viên xử lý trên admin." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#CBD5E1;dashed=1;dashPattern=6 4;">
          <mxGeometry x="40" y="920" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-sepay-api" parent="p1-1" edge="1" source="p1-ngan-hang" target="p1-api" value="7 · SePay báo tiền vào · tuỳ chọn&lt;br&gt;POST /payments/sepay/webhook · HMAC-SHA256" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=0;exitX=0.9629629629629629;exitY=0;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=6 4;">
          <mxGeometry x="0" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="870" />
              <mxPoint x="1330" y="870" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-diem-can-nho" parent="p1-1" vertex="1" value="&lt;b&gt;Điểm cần nhớ&lt;/b&gt;&lt;br&gt;API quyết định giá, chỗ trống, trạng thái đơn và giữ dữ liệu nghiệp vụ.&lt;br&gt;Web và admin hiển thị dữ liệu và gửi yêu cầu đến API.&lt;br&gt;Trình duyệt khách chỉ gọi gotrips-web, trừ ảnh VietQR tải từ vietqr.app." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="620" y="920" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-chua-co" parent="p1-1" vertex="1" value="&lt;b&gt;Chưa có&lt;/b&gt;&lt;br&gt;Thanh toán thẻ/ví điện tử, chức năng hoàn tiền, API sửa danh mục tiện ích.&lt;br&gt;Ngừng bán lịch bay còn đơn tương lai, giới hạn lần nhập sai mật khẩu.&lt;br&gt;Xác minh email, quên mật khẩu, trang điều khoản, thu hồi hoặc làm mới JWT.&lt;br&gt;Giới hạn gửi hoặc huỷ đăng ký nhận ưu đãi." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;dashed=1;dashPattern=6 4;">
          <mxGeometry x="1320" y="920" width="690" height="130" as="geometry" />

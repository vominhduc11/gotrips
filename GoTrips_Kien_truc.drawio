        <mxCell id="p2-start-api-admin" parent="p2-network" edge="1" source="p2-api" target="p2-admin" value="2 · API đạt UP&lt;br&gt;3 · Admin khởi động" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=13;strokeColor=#7E22CE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.2727272727272727;entryX=0;entryY=0.45454545454545453;exitPerimeter=0;entryPerimeter=0;">
          <mxGeometry x="0.57" relative="1" as="geometry">
            <mxPoint x="0" y="-27" as="offset" />
            <Array as="points">
              <mxPoint x="1030" y="210" />

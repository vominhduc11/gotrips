        <mxCell id="p4-web-cache" parent="p4-1" vertex="1" value="&lt;b&gt;Web cache gì&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;horizontal=1;rounded=0;collapsible=0;startSize=50;align=left;spacingLeft=16;verticalAlign=middle;fontSize=16;fontColor=#0F172A;fillColor=#E0F2FE;swimlaneFillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.5;">

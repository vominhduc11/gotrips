        <mxCell id="p2-db-env" parent="p2-network" vertex="1" value="&lt;b&gt;Biến môi trường · Cơ sở dữ liệu&lt;/b&gt;&lt;br&gt;POSTGRES_DB (bắt buộc)&lt;br&gt;POSTGRES_USER (bắt buộc)&lt;br&gt;POSTGRES_PASSWORD (bắt buộc)" style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="40" y="330" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-api-env" parent="p2-network" vertex="1" value="&lt;b&gt;Biến môi trường · API&lt;/b&gt;&lt;br&gt;GOTRIPS_JWT_SECRET (bắt buộc, ít nhất 32 byte)&lt;br&gt;SPRING_DATASOURCE_URL (Compose ghép từ POSTGRES_DB)&lt;br&gt;SPRING_DATASOURCE_USERNAME (từ POSTGRES_USER)&lt;br&gt;SPRING_DATASOURCE_PASSWORD (từ POSTGRES_PASSWORD)&lt;br&gt;SERVER_PORT (Compose: 8080)&lt;br&gt;SPRING_PROFILES_ACTIVE (mặc định Compose: seed)&lt;br&gt;GOTRIPS_JWT_ADMIN_EXPIRATION (mặc định: 8h)&lt;br&gt;GOTRIPS_ADMIN_COOKIE_SECURE (Compose: false, API: true)&lt;br&gt;GOTRIPS_BANK_NAME (bắt buộc ngoài seed)&lt;br&gt;GOTRIPS_BANK_ACCOUNT_NUMBER (bắt buộc ngoài seed)&lt;br&gt;GOTRIPS_BANK_ACCOUNT_NAME (bắt buộc ngoài seed)&lt;br&gt;GOTRIPS_BANK_QR_CODE (tuỳ chọn)&lt;br&gt;GOTRIPS_SEPAY_WEBHOOK_SECRET (tuỳ chọn)&lt;br&gt;GOTRIPS_CATALOG_ALLOWED_IMAGE_PREFIXES (tuỳ chọn)&lt;br&gt;GOTRIPS_WEB_REVALIDATE_URL (tuỳ chọn)&lt;br&gt;GOTRIPS_REVALIDATE_SECRET (bắt buộc khi bật webhook)&lt;br&gt;GOTRIPS_JWT_EXPIRATION (mặc định API: 7d)&lt;br&gt;GOTRIPS_CORS_ORIGINS (tuỳ chọn)&lt;br&gt;SPRINGDOC_ENABLED (mặc định: true)&lt;br&gt;Ba biến cuối cùng do API đọc, Compose hiện chưa truyền vào." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=12;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="490" y="330" width="400" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p2-admin-env" parent="p2-network" vertex="1" value="&lt;b&gt;Biến môi trường · Admin&lt;/b&gt;&lt;br&gt;Lúc build: VITE_API_URL (mặc định: /api)&lt;br&gt;VITE_WEB_URL (tuỳ chọn): Compose truyền qua ARG VITE_WEB_URL lúc build.&lt;br&gt;Mặc định http://localhost:3000 cho liên kết “Xem trên website”.&lt;br&gt;Compose không truyền biến lúc chạy.&lt;br&gt;Dockerfile giữ người dùng của image nginx và không khai báo healthcheck." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="1200" y="220" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-web-env" parent="p2-network" vertex="1" value="&lt;b&gt;Biến môi trường · Web&lt;/b&gt;&lt;br&gt;API_URL (Compose: http://gotrips-api:8080, đọc lúc chạy)&lt;br&gt;GOTRIPS_REVALIDATE_SECRET (bắt buộc khi bật webhook, dùng chung với API)&lt;br&gt;NODE_ENV, NEXT_TELEMETRY_DISABLED, PORT, HOSTNAME (do Dockerfile đặt)&lt;br&gt;Compose không khai báo healthcheck riêng cho web." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="1200" y="590" width="620" height="120" as="geometry" />
        </mxCell>

          </mxGeometry>
        </mxCell>
        <mxCell id="p2-build-va-chay" parent="p2-1" vertex="1" value="&lt;b&gt;Build và chạy là hai giai đoạn&lt;/b&gt;&lt;br&gt;docker compose up --build dựng image trước khi khởi động container.&lt;br&gt;Lúc next build, API chưa chạy. loadSection dừng ở await io().&lt;br&gt;HTML dựng sẵn có khung Suspense. Nội dung được truyền dần khi có yêu cầu." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="40" y="1200" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-phat-trien" parent="p2-1" vertex="1" value="&lt;b&gt;Chạy khi phát triển&lt;/b&gt;&lt;br&gt;DB: docker compose up gotrips-db&lt;br&gt;API: ./mvnw spring-boot:run · 8080 · Có thể bật profile seed&lt;br&gt;Admin: npm run dev · 5173 · Vite chuyển /api/ tới localhost:8080&lt;br&gt;Web: next dev -p 3100 khi container dùng cổng 3000." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="700" y="1200" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-moi-truong-that" parent="p2-1" vertex="1" value="&lt;b&gt;Môi trường thật&lt;/b&gt;&lt;br&gt;Để SPRING_PROFILES_ACTIVE rỗng. Chạy sau HTTPS.&lt;br&gt;Đặt GOTRIPS_ADMIN_COOKIE_SECURE=true và đủ 3 biến GOTRIPS_BANK_*.&lt;br&gt;Mỗi môi trường dùng một GOTRIPS_JWT_SECRET riêng.&lt;br&gt;Cookie gotrips_session của web hiện chưa bật Secure." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="1360" y="1200" width="640" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-diem-can-nho" parent="p2-1" vertex="1" value="&lt;b&gt;Điểm cần nhớ&lt;/b&gt;&lt;br&gt;API đợi DB sẵn sàng. Admin và web cùng đủ điều kiện khởi động khi API đạt UP.&lt;br&gt;Các container gọi nhau qua mạng bridge. Cổng PostgreSQL trên máy chủ chỉ mở tại 127.0.0.1.&lt;br&gt;Ổ postgres_data giữ dữ liệu khi container DB được tạo lại." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="40" y="1390" width="1960" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

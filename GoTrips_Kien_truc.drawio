        </mxCell>
        <mxCell id="p2-start-api-web" parent="p2-network" edge="1" source="p2-api" target="p2-web" value="2 · API đạt UP&lt;br&gt;3 · Web khởi động" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=13;strokeColor=#0369A1;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.7272727272727273;entryX=0;entryY=0.5454545454545454;exitPerimeter=0;entryPerimeter=0;">
          <mxGeometry x="0.72" relative="1" as="geometry">
            <mxPoint x="0" y="-27" as="offset" />
            <Array as="points">
              <mxPoint x="1030" y="260" />
              <mxPoint x="1030" y="500" />

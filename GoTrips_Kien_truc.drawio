        <mxCell id="p2-api" parent="p2-network" vertex="1" value="&lt;b&gt;gotrips-api · 8080 → 8080&lt;/b&gt;&lt;br&gt;builder: eclipse-temurin:25-jdk · Maven Wrapper&lt;br&gt;Chạy: eclipse-temurin:25-jre-noble · Người dùng spring&lt;br&gt;java -jar app.jar&lt;br&gt;Kiểm tra: /actuator/health → UP · start_period: 40 giây" style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#DCFCE7;strokeColor=#15803D;">

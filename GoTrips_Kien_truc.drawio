        <mxCell id="p4-bang-cache" parent="p4-web-cache" vertex="1" value="&lt;table style=&quot;border-collapse:collapse;table-layout:fixed;text-align:left;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;width:530px;border:1px solid #CBD5E1;background:#E0F2FE;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Dữ liệu&lt;/th&gt;&lt;th style=&quot;width:520px;border:1px solid #CBD5E1;background:#E0F2FE;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Tag (cacheTag)&lt;/th&gt;&lt;th style=&quot;width:200px;border:1px solid #CBD5E1;background:#E0F2FE;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Nhóm cacheLife&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Banner trang chủ (cấu hình của web)&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;site&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;days&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Điểm đến&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;destinations, tours&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;hours&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Tour nổi bật&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;tours, departures&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;hours&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Kết quả tìm tour&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;tours, departures, destinations&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;hours&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Chi tiết tour&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;tours, departures, testimonials&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;hours&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Khách sạn nổi bật, gợi ý, tìm kiếm và chi tiết&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;hotels, destinations&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;hours&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Kết quả tìm vé và chi tiết lịch bay&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;flights, airports&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;minutes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Chặng bay phổ biến&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;flight-routes, airports&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;hours&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Sân bay&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;airports&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;days&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:530px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:600;padding:3px 8px;vertical-align:middle;&quot;&gt;Đánh giá&lt;/td&gt;&lt;td style=&quot;width:520px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;testimonials, tours&lt;/td&gt;&lt;td style=&quot;width:200px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:3px 8px;vertical-align:middle;&quot;&gt;days&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#CBD5E1;">
          <mxGeometry x="40" y="90" width="1360" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p4-pham-vi-cache" parent="p4-web-cache" vertex="1" value="&lt;b&gt;Cache ở máy chủ web&lt;/b&gt;&lt;br&gt;Danh mục dùng &quot;use cache&quot;, cacheLife và cacheTag trong bộ nhớ tiến trình.&lt;br&gt;Đơn đặt chỗ, hồ sơ, phiên đăng nhập và lượt kiểm chuyến bay lúc đặt dùng no-store.&lt;br&gt;Sửa hồ sơ xong, Server Action gọi refresh() để cập nhật trang và Header.&lt;br&gt;loadSection đợi yêu cầu thật bằng await io() trước khi nạp từng khối.&lt;br&gt;Ở bản triển khai, lượt đọc sau mốc revalidate sẽ nạp lại từ API.&lt;br&gt;minutes: 1 phút · hours: 1 giờ · days: 1 ngày." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="1440" y="90" width="840" height="280" as="geometry" />
        </mxCell>

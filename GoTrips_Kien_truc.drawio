        <mxCell id="p4-bang-thao-tac" parent="p4-1" vertex="1" value="&lt;b&gt;Thao tác → tag bị làm mới&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;table-layout:fixed;text-align:left;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;width:540px;border:1px solid #CBD5E1;background:#DCFCE7;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Thao tác&lt;/th&gt;&lt;th style=&quot;width:680px;border:1px solid #CBD5E1;background:#DCFCE7;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Tag bị làm mới&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:540px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Admin ghi điểm đến, tour, chuyến khởi hành&lt;/td&gt;&lt;td style=&quot;width:680px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:4px 8px;vertical-align:middle;&quot;&gt;tours, departures, destinations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:540px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Admin ghi khách sạn, loại phòng&lt;/td&gt;&lt;td style=&quot;width:680px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:4px 8px;vertical-align:middle;&quot;&gt;hotels, destinations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:540px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Admin ghi hãng bay, lịch bay&lt;/td&gt;&lt;td style=&quot;width:680px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:4px 8px;vertical-align:middle;&quot;&gt;flights&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:540px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Admin ghi sân bay&lt;/td&gt;&lt;td style=&quot;width:680px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:4px 8px;vertical-align:middle;&quot;&gt;airports&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:540px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Admin ghi chặng phổ biến&lt;/td&gt;&lt;td style=&quot;width:680px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:4px 8px;vertical-align:middle;&quot;&gt;flight-routes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:540px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Admin huỷ đơn&lt;/td&gt;&lt;td style=&quot;width:680px;border:1px solid #CBD5E1;background:#F8FAFC;font-size:13px;font-weight:400;padding:4px 8px;vertical-align:middle;&quot;&gt;tours, departures, hotels, flights&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:540px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:600;padding:4px 8px;vertical-align:middle;&quot;&gt;Khách tạo đơn từ web&lt;/td&gt;&lt;td style=&quot;width:680px;border:1px solid #CBD5E1;background:#FFFFFF;font-size:13px;font-weight:400;padding:4px 8px;vertical-align:middle;&quot;&gt;Tour: tours, departures · Khách sạn: hotels · Vé: flights&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=14;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#CBD5E1;">
          <mxGeometry x="40" y="1570" width="1350" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p4-tag-cho-phep" parent="p4-1" vertex="1" value="&lt;b&gt;Tag /api/revalidate chấp nhận&lt;/b&gt;&lt;br&gt;destinations, tours, departures, hotels, flights, flight-routes, airports.&lt;br&gt;Sai hoặc thiếu bí mật: 401. Danh sách tag không hợp lệ: 400.&lt;br&gt;Đánh giá được làm mới qua tag tours. Route không nhận site và testimonials.&lt;br&gt;Thiếu URL: bỏ qua webhook. Thiếu bí mật API hoặc hàng đợi đầy: ghi WARN." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="1430" y="1570" width="930" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-diem-can-nho" parent="p4-1" vertex="1" value="&lt;b&gt;Điểm cần nhớ&lt;/b&gt;&lt;br&gt;Khởi động lại container web sẽ mất cache trong bộ nhớ của tiến trình đó.&lt;br&gt;API chỉ gửi tới một URL. Khi có nhiều bản chạy web, cần xem lại cách làm mới.&lt;br&gt;Lượt đọc tại máy chủ lấy dữ liệu mới sau khi tag bị làm hết hạn." style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;">
          <mxGeometry x="1430" y="1710" width="930" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

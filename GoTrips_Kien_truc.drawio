        <mxCell id="p2-web" parent="p2-network" vertex="1" value="&lt;b&gt;gotrips-web · 3000 → 3000&lt;/b&gt;&lt;br&gt;deps → builder → runner: node:24-alpine&lt;br&gt;npm ci → npm run build → node server.js&lt;br&gt;Đầu ra standalone · Người dùng nextjs" style="rounded=0;html=1;whiteSpace=wrap;overflow=visible;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#0F172A;fillColor=#E0F2FE;strokeColor=#0369A1;">

        <mxCell id="p2-capacity" parent="p2-lane-api" vertex="1" value="&lt;b&gt;Đủ sức chứa?&lt;/b&gt;&lt;br&gt;guests ≤ maxGuests × rooms" style="rhombus;perimeter=rhombusPerimeter;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontStyle=1;labelWidth=149;">

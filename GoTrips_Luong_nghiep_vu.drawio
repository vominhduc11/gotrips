        <mxCell id="p2-to-admin" parent="p2-lane-guest" vertex="1" value="&lt;a href=&quot;data:page/id,p4-trang&quot; style=&quot;color:inherit;text-decoration:underline;&quot;&gt;&lt;b&gt;→ Trang 04&lt;/b&gt;&lt;br&gt;Nhân viên xử lý đơn&lt;/a&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;dashed=1;dashPattern=6 4;">
          <mxGeometry x="9180" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-refresh-end" parent="p2-lane-web" vertex="1" value="■" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=3;" tooltip="Kết thúc">
          <mxGeometry x="9260" y="200" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-chot-don" parent="p2-1" vertex="1" value="&lt;b&gt;Giao dịch và chi tiết đơn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mã GT + 6 ký tự. Kiểm trước: sinh mã khác nếu mã đã dùng. Vi phạm uq_bookings_code: chạy lại toàn bộ giao dịch, tối đa 3 lần.&lt;br&gt;Đơn mới PENDING, thanh toán BANK_TRANSFER / UNPAID. Số tiền và đơn giá được lưu lúc tạo.&lt;br&gt;Nội dung chuyển khoản là mã đơn. Tài khoản nhận lấy từ GOTRIPS_BANK_*. Xem cách đọc đơn ở trang 04." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="7620" y="1970" width="1510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-api-unavailable" parent="p2-lane-api" vertex="1" value="&lt;b&gt;Mạng / 5xx&lt;/b&gt;&lt;br&gt;“Hệ thống đang bận…”" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">
          <mxGeometry x="7680" y="260" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-error-handler" parent="p2-lane-web" vertex="1" value="&lt;a href=&quot;data:page/id,p1-trang&quot; style=&quot;color:inherit;text-decoration:underline;&quot;&gt;&lt;b&gt;→ Trang 01 · Web xử lý lỗi từ API&lt;/b&gt;&lt;br&gt;Chuyển đăng nhập hoặc báo lỗi ở biểu mẫu&lt;/a&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E0F2FE;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;dashed=1;dashPattern=6 4;">
          <mxGeometry x="6780" y="220" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-luot-tim" parent="p2-1" vertex="1" value="&lt;b&gt;Tìm và chọn phòng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tìm ở /hotels?destination&amp;amp;checkIn&amp;amp;checkOut&amp;amp;guests&amp;amp;rooms. Kết quả xếp theo tổng tiền cả kỳ.&lt;br&gt;Nút −/+ giữ tổ hợp hợp lệ với sức chứa. URL trang đặt giữ room, checkIn, checkOut, guests, rooms và bước đang mở.&lt;br&gt;HotelBookingGate đọc lựa chọn từ URL và truyền vào biểu mẫu. API mới kiểm lại số phòng trống khi tạo đơn." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="220" y="1970" width="1340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-thu-tu-ngay" parent="p2-1" vertex="1" value="&lt;b&gt;Thứ tự báo lỗi lưu trú&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. “Ngày nhận phòng không được ở quá khứ.”&lt;br&gt;2. “Ngày trả phòng phải sau ngày nhận phòng.”&lt;br&gt;3. “Mỗi lần đặt tối đa ” + 30 đêm.&lt;br&gt;4. “Số phòng không được nhiều hơn số khách.”&lt;br&gt;5. “Đặt phòng trực tuyến chỉ nhận phòng từ ngày mai…”" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="6120" y="1970" width="1220" height="160" as="geometry" />
        </mxCell>

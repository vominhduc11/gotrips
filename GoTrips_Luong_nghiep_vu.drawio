        <mxCell id="p2-sold-out" parent="p2-lane-api" vertex="1" value="&lt;b&gt;409 · Đầu biểu mẫu&lt;/b&gt;&lt;br&gt;“Loại phòng này chỉ còn ” + số phòng&lt;br&gt;hoặc “Loại phòng này đã hết phòng…”" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">

        <mxCell id="p2-price" parent="p2-lane-api" vertex="1" value="&lt;b&gt;19. Chốt giá và tạo đơn&lt;/b&gt;&lt;br&gt;Giá/đêm × số đêm × số phòng&lt;br&gt;PENDING / UNPAID" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">

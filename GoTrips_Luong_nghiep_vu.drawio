        <mxCell id="p2-lane-api" parent="p2-pool" vertex="1" value="gotrips-api" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;fontFamily=Arial;startSize=130;rounded=0;collapsible=0;swimlaneFillColor=#F4FCF6;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=14;fontStyle=1;fontColor=#0F172A;strokeWidth=1.5;">

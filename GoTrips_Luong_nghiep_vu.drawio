        <mxCell id="p2-capacity-fail" parent="p2-lane-api" vertex="1" value="&lt;b&gt;400 · Đầu biểu mẫu&lt;/b&gt;&lt;br&gt;“Loại phòng này ở tối đa ” + sức chứa&lt;br&gt;mỗi phòng" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">

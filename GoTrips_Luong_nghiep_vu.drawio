        </mxCell>
        <mxCell id="p2-lane-db" parent="p2-pool" vertex="1" value="PostgreSQL" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;fontFamily=Arial;startSize=130;rounded=0;collapsible=0;swimlaneFillColor=#F8FAFC;fillColor=#E5E7EB;strokeColor=#6B7280;fontSize=14;fontStyle=1;fontColor=#0F172A;strokeWidth=1.5;">
          <mxGeometry x="0" y="1270" width="9700" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-cach-doc" parent="p2-1" vertex="1" value="&lt;b&gt;Cách đọc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc từ trái sang phải trong một làn, theo mũi tên khi chuyển làn.&lt;br&gt;○ Viền xanh · Bắt đầu    ● Viền đậm · Kết thúc    ▭ Hộp bo góc có số · Bước    ◇ Hình thoi có câu hỏi · Quyết định&lt;br&gt;Hộp đỏ · Lỗi và nơi hiển thị    |    Hộp trong PostgreSQL · Thao tác trên bảng    |    Nhãn cạnh · Điều kiện, điểm gọi hoặc mã HTTP&lt;br&gt;Nét đứt · Nhánh thay thế, hộp thoại, mục chưa có hoặc liên kết → Trang khác" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="40" y="170" width="1100" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-du-lieu" parent="p2-1" vertex="1" value="&lt;b&gt;Dữ liệu gửi lên API&lt;/b&gt;&lt;br&gt;&lt;br&gt;CreateHotelBookingRequest · roomTypeId, checkIn, checkOut, guests, rooms, contact, guestName, note.&lt;br&gt;contact {fullName, email, phone} · guestName là người nhận phòng.&lt;br&gt;note có thể trống · Không có trường giá." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="1180" y="170" width="1180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-ghi-nho" parent="p2-1" vertex="1" value="&lt;b&gt;Điểm cần nhớ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không lưu số phòng đã đặt. API tính lại phòng trống lúc tìm và lúc đặt · huỷ đơn là phòng tự trống.&lt;br&gt;Hai đơn không chung đêm vẫn được cộng nếu cả hai giao với khoảng đang hỏi.&lt;br&gt;Khoá khách sạn trước loại phòng. Tìm có thể nhận hôm nay, đặt trực tuyến chỉ từ ngày mai." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="2400" y="170" width="1680" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-pha-0" parent="p2-1" vertex="1" value="Tìm và chọn kỳ lưu trú" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#475569;fontSize=14;fontStyle=1;align=left;spacingLeft=12;">

        <mxCell id="p2-invalid-dates" parent="p2-lane-api" vertex="1" value="&lt;b&gt;400 · Đầu biểu mẫu&lt;/b&gt;&lt;br&gt;“Ngày trả phòng phải sau ngày nhận phòng.”&lt;br&gt;Xem thứ tự và các câu bên dưới" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">

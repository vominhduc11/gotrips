        <mxCell id="p2-insert" parent="p2-lane-db" vertex="1" value="&lt;b&gt;20. INSERT đơn và thanh toán&lt;/b&gt;&lt;br&gt;bookings, hotel_bookings, payments" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">

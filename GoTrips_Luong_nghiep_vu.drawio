        <mxCell id="p4-row-3-col-5" parent="p4-row-3" vertex="1" value="Trả chỗ tour · làm mới cache nếu bật webhook" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=1;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#0F172A;strokeColor=#DDD6FE;">

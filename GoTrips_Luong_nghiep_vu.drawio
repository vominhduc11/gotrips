        <mxCell id="p2-detail" parent="p2-lane-guest" vertex="1" value="&lt;b&gt;23. Mở /bookings/[code]&lt;/b&gt;&lt;br&gt;Xem đơn và cách chuyển khoản" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">

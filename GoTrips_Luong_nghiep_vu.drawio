        <mxCell id="p3-lane-db" parent="p3-pool" vertex="1" value="PostgreSQL" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;fontFamily=Arial;startSize=130;rounded=0;collapsible=0;swimlaneFillColor=#F8FAFC;fillColor=#E5E7EB;strokeColor=#6B7280;fontSize=14;fontStyle=1;fontColor=#0F172A;strokeWidth=1.5;">
          <mxGeometry x="0" y="1270" width="10600" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p3-cach-doc" parent="p3-1" vertex="1" value="&lt;b&gt;Cách đọc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc từ trái sang phải trong một làn, theo mũi tên khi chuyển làn.&lt;br&gt;○ Viền xanh · Bắt đầu    ● Viền đậm · Kết thúc    ▭ Hộp bo góc có số · Bước    ◇ Hình thoi có câu hỏi · Quyết định&lt;br&gt;Hộp đỏ · Lỗi và nơi hiển thị    |    Hộp trong PostgreSQL · Thao tác trên bảng    |    Nhãn cạnh · Điều kiện, điểm gọi hoặc mã HTTP&lt;br&gt;Nét đứt · Nhánh thay thế, hộp thoại, mục chưa có hoặc liên kết → Trang khác" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="40" y="170" width="1100" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-du-lieu" parent="p3-1" vertex="1" value="&lt;b&gt;Dữ liệu gửi lên API&lt;/b&gt;&lt;br&gt;&lt;br&gt;CreateFlightBookingRequest · outboundScheduleId, returnScheduleId, from, to, departDate, returnDate, cabin, contact, passengers, note.&lt;br&gt;contact {fullName, email, phone} · passengers[] {type, fullName, dateOfBirth} · một chiều bỏ trường về.&lt;br&gt;note có thể trống · Không có trường giá." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="1180" y="170" width="1180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-ghi-nho" parent="p3-1" vertex="1" value="&lt;b&gt;Điểm cần nhớ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Em bé đi cùng người lớn và không chiếm ghế. Ghế đã bán đếm từ các đơn chưa huỷ.&lt;br&gt;Lịch bay chạy hằng ngày. Sức chứa từng hạng nằm trên flight_schedules.&lt;br&gt;FlightFareCalculator tính đơn giá vé duy nhất · FlightPricing cộng các dòng tiền theo chặng và loại khách.&lt;br&gt;Khoá các lịch theo id tăng dần để tránh khoá chéo khi hai đơn khứ hồi chọn lịch ngược nhau." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="2400" y="170" width="1680" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-pha-0" parent="p3-1" vertex="1" value="Tìm vé và chọn một hoặc hai chuyến" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#475569;fontSize=14;fontStyle=1;align=left;spacingLeft=12;">

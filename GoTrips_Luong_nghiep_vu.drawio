          <mxGeometry x="0" y="0" width="9400" height="420" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane-bank" parent="p4-pool" vertex="1" value="Ngân hàng (ngoài hệ thống)" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;fontFamily=Arial;startSize=130;rounded=0;collapsible=0;swimlaneFillColor=#F8FAFC;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=14;fontStyle=1;fontColor=#0F172A;strokeWidth=1.5;">
          <mxGeometry x="0" y="420" width="9400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane-admin" parent="p4-pool" vertex="1" value="Nhân viên (gotrips-admin)" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;fontFamily=Arial;startSize=130;rounded=0;collapsible=0;swimlaneFillColor=#FBF7FF;fillColor=#F3E8FF;strokeColor=#7E22CE;fontSize=14;fontStyle=1;fontColor=#0F172A;strokeWidth=1.5;">
          <mxGeometry x="0" y="680" width="9400" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane-api" parent="p4-pool" vertex="1" value="gotrips-api" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;fontFamily=Arial;startSize=130;rounded=0;collapsible=0;swimlaneFillColor=#F4FCF6;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=14;fontStyle=1;fontColor=#0F172A;strokeWidth=1.5;">
          <mxGeometry x="0" y="1240" width="9400" height="580" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane-db" parent="p4-pool" vertex="1" value="PostgreSQL" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;fontFamily=Arial;startSize=130;rounded=0;collapsible=0;swimlaneFillColor=#F8FAFC;fillColor=#E5E7EB;strokeColor=#6B7280;fontSize=14;fontStyle=1;fontColor=#0F172A;strokeWidth=1.5;">
          <mxGeometry x="0" y="1820" width="9400" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane-web" parent="p4-pool" vertex="1" value="gotrips-web" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;fontFamily=Arial;startSize=130;rounded=0;collapsible=0;swimlaneFillColor=#F3FAFE;fillColor=#E0F2FE;strokeColor=#0369A1;fontSize=14;fontStyle=1;fontColor=#0F172A;strokeWidth=1.5;">
          <mxGeometry x="0" y="2210" width="9400" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p4-cach-doc" parent="p4-1" vertex="1" value="&lt;b&gt;Cách đọc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc từ trái sang phải trong một làn, theo mũi tên khi chuyển làn.&lt;br&gt;○ Viền xanh · Bắt đầu    ● Viền đậm · Kết thúc    ▭ Hộp bo góc có số · Bước    ◇ Hình thoi có câu hỏi · Quyết định&lt;br&gt;Hộp đỏ · Lỗi và nơi hiển thị    |    Hộp trong PostgreSQL · Thao tác trên bảng    |    Nhãn cạnh · Điều kiện, điểm gọi hoặc mã HTTP&lt;br&gt;Nét đứt · Nhánh thay thế, hộp thoại, mục chưa có hoặc liên kết → Trang khác" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="40" y="170" width="1100" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-du-lieu" parent="p4-1" vertex="1" value="&lt;b&gt;Dữ liệu gửi lên API&lt;/b&gt;&lt;br&gt;&lt;br&gt;mark-paid, confirm, cancel · Không có thân yêu cầu. Mã đơn đi trong {code} · phiên quản trị dùng cookie và CSRF.&lt;br&gt;Webhook nhận id, gateway, transactionDate, accountNumber, code, content, transferType, transferAmount, referenceCode.&lt;br&gt;Đối chiếu: assign {bookingCode}, resolve {note} · id giao dịch trong đường dẫn. Thao tác trên đơn không có trường giá." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="1180" y="170" width="1180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-ghi-nho" parent="p4-1" vertex="1" value="&lt;b&gt;Điểm cần nhớ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chưa thu đủ tiền thì chưa xác nhận được. Đơn PENDING giữ chỗ tới khi nhân viên huỷ · không có tác vụ hết hạn.&lt;br&gt;Huỷ được đơn CONFIRMED kể cả sau ngày dịch vụ. Khách chưa tự huỷ đơn trên trang web.&lt;br&gt;Đơn giữ giá đã chốt · tên tour, khách sạn, hãng bay vẫn đọc từ danh mục hiện tại.&lt;br&gt;Khi có SePay, đủ tiền có thể xác nhận tự động nếu dịch vụ bắt đầu sau hôm nay." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="2400" y="170" width="1680" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-pha-0" parent="p4-1" vertex="1" value="Khách thanh toán · Nhân viên mở và đối chiếu đơn" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#475569;fontSize=14;fontStyle=1;align=left;spacingLeft=12;">
          <mxGeometry x="220" y="2990" width="1800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-pha-1" parent="p4-1" vertex="1" value="Xử lý đơn · Nhánh nét đứt phía dưới là đối chiếu qua SePay" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#475569;fontSize=14;fontStyle=1;align=left;spacingLeft=12;">
          <mxGeometry x="2320" y="2990" width="3640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-pha-2" parent="p4-1" vertex="1" value="Sau thao tác · Trả chỗ, xem trạng thái và xử lý khoản cần hoàn" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#475569;fontSize=14;fontStyle=1;align=left;spacingLeft=12;">
          <mxGeometry x="6220" y="2990" width="3080" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-start" parent="p4-lane-guest" vertex="1" value="▶" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;" tooltip="Bắt đầu">
          <mxGeometry x="260" y="60" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-open" parent="p4-lane-guest" vertex="1" value="&lt;b&gt;1. Mở /bookings/[code]&lt;/b&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="480" y="40" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-load-initial" parent="p4-lane-web" vertex="1" value="&lt;b&gt;2. Đọc đơn với Bearer của khách&lt;/b&gt;&lt;br&gt;no-store" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="780" y="40" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-initial-api" parent="p4-lane-api" vertex="1" value="&lt;b&gt;3. Kiểm chủ đơn và lấy bankTransfer&lt;/b&gt;&lt;br&gt;Ẩn với đơn của người khác" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="780" y="40" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-initial-result" parent="p4-lane-web" vertex="1" value="&lt;b&gt;4. Trả chi tiết đơn cho khách&lt;/b&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">

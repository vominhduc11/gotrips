        <mxCell id="p2-created" parent="p2-lane-api" vertex="1" value="&lt;b&gt;21. Ghép và trả chi tiết đơn&lt;/b&gt;&lt;br&gt;Giao dịch đã ghi thành công" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">

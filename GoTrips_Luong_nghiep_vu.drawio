        <mxCell id="p1-cach-doc" parent="p1-1" vertex="1" value="&lt;b&gt;Cách đọc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc từ trái sang phải trong một làn, theo mũi tên khi chuyển làn.&lt;br&gt;○ Viền xanh · Bắt đầu    ● Viền đậm · Kết thúc    ▭ Hộp bo góc có số · Bước    ◇ Hình thoi có câu hỏi · Quyết định&lt;br&gt;Hộp đỏ · Lỗi và nơi hiển thị    |    Hộp trong PostgreSQL · Thao tác trên bảng    |    Nhãn cạnh · Điều kiện, điểm gọi hoặc mã HTTP&lt;br&gt;Nét đứt · Nhánh thay thế, hộp thoại, mục chưa có hoặc liên kết → Trang khác" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="40" y="170" width="1100" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-du-lieu" parent="p1-1" vertex="1" value="&lt;b&gt;Dữ liệu gửi lên API&lt;/b&gt;&lt;br&gt;&lt;br&gt;CreateTourBookingRequest · departureId, guests, contact, travelers, note.&lt;br&gt;contact {fullName, email, phone} · travelers[] {fullName, dateOfBirth có thể trống}.&lt;br&gt;note có thể trống · Không có trường giá." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="1180" y="170" width="1180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-ghi-nho" parent="p1-1" vertex="1" value="&lt;b&gt;Điểm cần nhớ&lt;/b&gt;&lt;br&gt;&lt;br&gt;API đọc giá chuyến trong DB và chốt vào đơn. Đổi giá danh mục về sau không đổi giá đơn cũ.&lt;br&gt;Khoá tour trước chuyến · lệnh quản trị danh mục cũng dùng thứ tự này để tránh khoá chéo.&lt;br&gt;Tạo đơn tăng booked_seats ngay · huỷ đơn trả chỗ. Chỉ đặt trực tuyến chuyến từ ngày mai." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="2400" y="170" width="1680" height="130" as="geometry" />
        </mxCell>

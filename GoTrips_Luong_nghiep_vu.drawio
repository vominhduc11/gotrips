        </mxCell>
        <mxCell id="p4-ghi-chu-bang" parent="p4-1" vertex="1" value="Các nút thao tác trên trang quản trị xuất hiện theo availableActions mà API trả về." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;spacingLeft=10;fillColor=none;strokeColor=none;fontSize=14;fontColor=#475569;">
          <mxGeometry x="2020" y="3350" width="2190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-loi-admin" parent="p4-1" vertex="1" value="&lt;b&gt;Khi hai người cùng thao tác&lt;/b&gt;&lt;br&gt;&lt;br&gt;lockByCode buộc các lệnh xếp hàng. Lệnh đến sau kiểm trạng thái mới và có thể trả 409.&lt;br&gt;“Chỉ đánh dấu đã thanh toán được cho đơn đang chờ xác nhận và chưa thanh toán.”&lt;br&gt;“Chỉ xác nhận được đơn đang chờ xác nhận và đã thanh toán.”&lt;br&gt;“Đơn này đã huỷ trước đó.”" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="4720" y="3070" width="1240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p4-doi-chieu" parent="p4-1" vertex="1" value="&lt;b&gt;API quản trị giao dịch ngân hàng&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /admin/bank-transactions trả danh sách giao dịch · gồm khoản lệch và các thao tác theo availableActions.&lt;br&gt;POST /admin/bank-transactions/{id}/assign với bookingCode. Khoá giao dịch trước khoá đơn · dùng chung luật cộng tiền.&lt;br&gt;POST /admin/bank-transactions/{id}/resolve với note. Lưu kết quả nhân viên đã xử lý lệch, chẳng hạn đã hoàn bên ngoài.&lt;br&gt;Khoản chuyển thiếu đã tính vào đơn bị huỷ cũng cần hoàn. Khoản đã thu đủ và huỷ nằm ở danh sách Cần hoàn tiền của đơn.&lt;br&gt;Webhook cần GOTRIPS_SEPAY_WEBHOOK_SECRET. Trang đơn đang chờ tiền hỏi GET /bookings/{code}/payment-status mỗi 5 giây qua /api/bookings/[code]/payment-status của web, thấy đổi thì tự tải lại, ngừng sau 180 lần." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="6220" y="3070" width="1870" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4-cache" parent="p4-1" vertex="1" value="&lt;b&gt;Cache và đọc lại đơn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Service phát WebCatalogChanged trong giao dịch huỷ. Listener sau COMMIT gọi webhook bất đồng bộ nếu đã cấu hình.&lt;br&gt;Xem GoTrips_Kien_truc.drawio, trang 04 · Làm mới cache. Phòng và ghế đã trả theo trạng thái đơn đã ghi trong DB.&lt;br&gt;Mã sai định dạng đi thẳng 404 tại web. Nếu chưa có phiên hoặc API trả 401, web đưa về /login?next=&amp;lt;trang đơn&amp;gt;." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="4720" y="3250" width="1240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-chua-co" parent="p4-1" vertex="1" value="&lt;b&gt;Chưa có&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cổng thanh toán trực tuyến tích hợp tại bước đặt chỗ, chức năng thực hiện hoàn tiền trong hệ thống.&lt;br&gt;Tự huỷ đơn quá hạn, khách tự huỷ đơn và email thông báo." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;dashed=1;dashPattern=6 4;">
          <mxGeometry x="220" y="3070" width="1520" height="120" as="geometry" />
        </mxCell>

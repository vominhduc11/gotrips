        <mxCell id="p2-success" parent="p2-lane-web" vertex="1" value="&lt;b&gt;22. Trả mã và đường dẫn đơn&lt;/b&gt;&lt;br&gt;Lên lịch after() làm mới cache" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">

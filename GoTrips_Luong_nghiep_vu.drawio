        </mxCell>
        <mxCell id="p1-travelers" parent="p1-lane-api" vertex="1" value="&lt;b&gt;Số người đi khớp?&lt;/b&gt;&lt;br&gt;Ngày sinh không ở tương lai?" style="rhombus;perimeter=rhombusPerimeter;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontStyle=1;labelWidth=163;">
          <mxGeometry x="4080" y="40" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-travelers-fail" parent="p1-lane-api" vertex="1" value="&lt;b&gt;400 · Danh sách hoặc ngày sinh&lt;/b&gt;&lt;br&gt;“Số người đi phải bằng số khách đã chọn.”&lt;br&gt;“Ngày sinh không được sau hôm nay.”" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">
          <mxGeometry x="4080" y="260" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-find-tour" parent="p1-lane-db" vertex="1" value="&lt;b&gt;8. SELECT tour_id&lt;/b&gt;&lt;br&gt;tour_departures theo departureId" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="4080" y="60" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-lock-tour" parent="p1-lane-db" vertex="1" value="&lt;b&gt;9. tours · FOR SHARE&lt;/b&gt;&lt;br&gt;Khoá chia sẻ theo tour_id" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">

        <mxCell id="p1-account-fail" parent="p1-lane-api" vertex="1" value="&lt;b&gt;401 · Về đăng nhập&lt;/b&gt;&lt;br&gt;“Phiên đăng nhập không còn hợp lệ.”" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">
          <mxGeometry x="3780" y="310" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-request-fail" parent="p1-lane-api" vertex="1" value="&lt;b&gt;400 · Yêu cầu sai định dạng&lt;/b&gt;&lt;br&gt;@Valid · Hiện lỗi tại ô hoặc đầu form" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">

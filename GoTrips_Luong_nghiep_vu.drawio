        <mxCell id="p2-count" parent="p2-lane-db" vertex="1" value="&lt;b&gt;18. SELECT SUM số phòng đã giữ&lt;/b&gt;&lt;br&gt;hotel_bookings và bookings&lt;br&gt;Đơn chưa huỷ, khoảng ngày giao nhau" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="7380" y="60" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-enough" parent="p2-lane-api" vertex="1" value="&lt;b&gt;Còn đủ phòng?&lt;/b&gt;&lt;br&gt;total_rooms trừ số phòng đã giữ" style="rhombus;perimeter=rhombusPerimeter;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontStyle=1;labelWidth=156;">

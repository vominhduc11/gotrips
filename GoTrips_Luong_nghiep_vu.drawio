          <mxGeometry x="6780" y="220" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-luot-tim" parent="p3-1" vertex="1" value="&lt;b&gt;Tham số lượt tìm và đặt vé&lt;/b&gt;&lt;br&gt;&lt;br&gt;URL tìm: tripType, from, to, departDate, returnDate (khứ hồi), adults, children, infants, cabin.&lt;br&gt;API tìm dùng date cho từng chiều. URL /flights/book thêm out, ret (khứ hồi) và step khi chuyển bước.&lt;br&gt;Khi chọn chuyến đi, trang kết quả điền out và cuộn đến chiều về. Action tra lại không cache · Gate dùng getFlightOption có cache.&lt;br&gt;Gate trả về /flights nếu lượt tìm sai. Thiếu chuyến, sai chiều hoặc hết chỗ: giữ lượt tìm và cho chọn lại." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="220" y="1970" width="1520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-so-tuoi" parent="p3-1" vertex="1" value="&lt;b&gt;Thông tin hành khách và giữ ghế&lt;/b&gt;&lt;br&gt;&lt;br&gt;Zod đối chiếu số hành khách từng loại với lượt tìm. Trẻ em và em bé bắt buộc có ngày sinh.&lt;br&gt;API kiểm số lượng trước ngày sinh và tuổi. Tính theo ngày bay chiều đi: người lớn ≥12, trẻ em 2–11, em bé &amp;lt;2.&lt;br&gt;Ghế đã bán tính riêng theo lịch bay, ngày bay và hạng ghế · bỏ em bé và đơn CANCELLED." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="3520" y="1970" width="1450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-thu-tu-chang" parent="p3-1" vertex="1" value="&lt;b&gt;Thứ tự báo lỗi chặng và ngày&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. “Điểm đến phải khác điểm đi.”&lt;br&gt;2. “Ngày đi không được ở quá khứ.”&lt;br&gt;3. “Chuyến bay trong ngày hôm nay đã đóng đặt vé trực tuyến…”&lt;br&gt;4. “Vui lòng chọn chuyến về.”  5. “Vui lòng chọn ngày về.”&lt;br&gt;6. “Ngày về không được trước ngày đi.”" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="5600" y="1970" width="1050" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3-gia-ve" parent="p3-1" vertex="1" value="&lt;b&gt;Cách tính giá vé&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hệ số phổ thông / phổ thông cao cấp / thương gia / hạng nhất: 1 / 1,6 / 2,8 / 4,2.&lt;br&gt;Trẻ em 75%, em bé 10% trên giá người lớn cùng hạng. Làm tròn đến nghìn đồng.&lt;br&gt;Giá từng loại hành khách lưu vào flight_booking_segments và dùng lại khi xem đơn." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="6820" y="1970" width="1070" height="120" as="geometry" />
        </mxCell>

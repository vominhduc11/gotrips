        <mxCell id="p1-tour-active" parent="p1-lane-api" vertex="1" value="&lt;b&gt;Có chuyến và tour ACTIVE?&lt;/b&gt;" style="rhombus;perimeter=rhombusPerimeter;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontStyle=1;labelWidth=149;">
          <mxGeometry x="4380" y="40" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-missing" parent="p1-lane-api" vertex="1" value="&lt;b&gt;400 · Đầu biểu mẫu&lt;/b&gt;&lt;br&gt;“Chuyến khởi hành này không còn tồn tại…”" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">
          <mxGeometry x="4380" y="260" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-lock-departure" parent="p1-lane-db" vertex="1" value="&lt;b&gt;10. tour_departures · FOR NO KEY UPDATE&lt;/b&gt;&lt;br&gt;Khoá ghi chuyến theo departureId" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="4680" y="60" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-available" parent="p1-lane-api" vertex="1" value="&lt;b&gt;Còn chuyến mở bán từ ngày mai?&lt;/b&gt;" style="rhombus;perimeter=rhombusPerimeter;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontStyle=1;labelWidth=163;">
          <mxGeometry x="4680" y="40" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-closed" parent="p1-lane-api" vertex="1" value="&lt;b&gt;400 · Đầu biểu mẫu&lt;/b&gt;&lt;br&gt;“Chuyến này đã đóng đặt chỗ…”&lt;br&gt;Mất chuyến: “Chuyến khởi hành này không còn tồn tại…”" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">
          <mxGeometry x="4680" y="260" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-reserve" parent="p1-lane-db" vertex="1" value="&lt;b&gt;11. UPDATE tour_departures&lt;/b&gt;&lt;br&gt;SET booked_seats = booked_seats + guests&lt;br&gt;Chỉ khi đang mở và ≤ total_seats" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="4980" y="60" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-updated" parent="p1-lane-api" vertex="1" value="&lt;b&gt;Đã tăng booked_seats?&lt;/b&gt;" style="rhombus;perimeter=rhombusPerimeter;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontStyle=1;labelWidth=149;">
          <mxGeometry x="5280" y="40" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-sold-out" parent="p1-lane-api" vertex="1" value="&lt;b&gt;409 · Đầu biểu mẫu&lt;/b&gt;&lt;br&gt;“Chuyến này chỉ còn ” + số chỗ&lt;br&gt;hoặc “Chuyến này đã hết chỗ…”" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">
          <mxGeometry x="5280" y="260" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-price" parent="p1-lane-api" vertex="1" value="&lt;b&gt;12. Chốt giá và tạo đơn&lt;/b&gt;&lt;br&gt;Giá chuyến × số khách&lt;br&gt;GT + 6 ký tự · PENDING / UNPAID" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="5580" y="40" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-insert" parent="p1-lane-db" vertex="1" value="&lt;b&gt;13. INSERT đơn và thanh toán&lt;/b&gt;&lt;br&gt;bookings, booking_travelers,&lt;br&gt;tour_bookings, payments" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="5880" y="60" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-created" parent="p1-lane-api" vertex="1" value="&lt;b&gt;14. Ghép và trả chi tiết đơn&lt;/b&gt;&lt;br&gt;Giao dịch đã ghi thành công" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="6180" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-success" parent="p1-lane-web" vertex="1" value="&lt;b&gt;15. Trả mã và đường dẫn đơn&lt;/b&gt;&lt;br&gt;Lên lịch after() làm mới cache" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="6480" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-refresh" parent="p1-lane-web" vertex="1" value="&lt;b&gt;17. Làm mới thẻ cache&lt;/b&gt;&lt;br&gt;tours, departures&lt;br&gt;Chạy sau khi gửi phản hồi" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="6780" y="180" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-detail" parent="p1-lane-guest" vertex="1" value="&lt;b&gt;16. Mở /bookings/[code]&lt;/b&gt;&lt;br&gt;Xem đơn và cách chuyển khoản" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;">
          <mxGeometry x="6780" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-to-admin" parent="p1-lane-guest" vertex="1" value="&lt;a href=&quot;data:page/id,p4-trang&quot; style=&quot;color:inherit;text-decoration:underline;&quot;&gt;&lt;b&gt;→ Trang 04&lt;/b&gt;&lt;br&gt;Nhân viên xử lý đơn&lt;/a&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;dashed=1;dashPattern=6 4;">
          <mxGeometry x="7080" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-refresh-end" parent="p1-lane-web" vertex="1" value="■" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=3;" tooltip="Kết thúc">
          <mxGeometry x="7160" y="200" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-chot-don" parent="p1-1" vertex="1" value="&lt;b&gt;Giao dịch và chi tiết đơn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mã GT + 6 ký tự. Kiểm trước: sinh mã khác nếu mã đã dùng. Vi phạm uq_bookings_code: chạy lại toàn bộ giao dịch, tối đa 3 lần.&lt;br&gt;Đơn mới PENDING, thanh toán BANK_TRANSFER / UNPAID. Số tiền và đơn giá được lưu lúc tạo.&lt;br&gt;Nội dung chuyển khoản là mã đơn. Tài khoản nhận lấy từ GOTRIPS_BANK_*. Xem cách đọc đơn ở trang 04." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="5520" y="1970" width="1510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p1-error-handler" parent="p1-lane-web" vertex="1" value="&lt;b&gt;Web xử lý lỗi từ API&lt;/b&gt;&lt;br&gt;401 → /login?next=&amp;lt;trang đang đặt&amp;gt;&lt;br&gt;400 / 409 → ô tương ứng hoặc đầu biểu mẫu&lt;br&gt;Mạng / 5xx → “Hệ thống đang bận…”" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">
          <mxGeometry x="4680" y="220" width="530" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-api-unavailable" parent="p1-lane-api" vertex="1" value="&lt;b&gt;Mạng / 5xx&lt;/b&gt;&lt;br&gt;Lỗi khi gửi hoặc xử lý yêu cầu" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fontColor=#7F1D1D;">
          <mxGeometry x="5580" y="260" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-chon-ngay" parent="p1-1" vertex="1" value="&lt;b&gt;Chi tiết chọn chuyến&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nút Chọn ngày này trong lịch chỉ đổi lựa chọn và đưa tiêu điểm về ô ngày trong thẻ Đặt tour.&lt;br&gt;URL trang đặt giữ departure, guests và step khi chuyển bước. Thiếu lựa chọn hợp lệ: trả về #dat-tour.&lt;br&gt;BookingWizard chuẩn hoá số khách theo số chỗ. API đọc giá sau khi khoá chuyến, trước khi cập nhật số chỗ. Khoá ghi JPA dùng FOR NO KEY UPDATE trên PostgreSQL." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="220" y="1970" width="1150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-loi-web" parent="p1-1" vertex="1" value="&lt;b&gt;Cách gắn lỗi theo trường&lt;/b&gt;&lt;br&gt;&lt;br&gt;submitBooking đổi travelers[0].fullName thành travelers.0.fullName. Lỗi về lựa chọn chuyến, phòng hoặc chặng hiển thị đầu form.&lt;br&gt;Nếu errors[] không có trường nhận được, form dùng detail hoặc title. Mã 401 hoặc thiếu token dẫn tới đăng nhập.&lt;br&gt;Controller kiểm @Valid trước BookingTransaction. Web dùng GET /auth/me khi có token để kiểm phiên." style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Arial;fillColor=#FEF3C7;strokeColor=#B45309;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=14;fontColor=#0F172A;">
          <mxGeometry x="1450" y="1970" width="1420" height="120" as="geometry" />
        </mxCell>

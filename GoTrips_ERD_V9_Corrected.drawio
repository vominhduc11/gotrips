        <mxCell id="constraint_hotel_bookings" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;hotel_bookings&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;PRIMARY KEY · hotel_bookings_pkey&lt;/b&gt;&lt;br&gt;PRIMARY KEY (booking_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;FOREIGN KEY · fk_hotel_bookings_booking&lt;/b&gt;&lt;br&gt;FOREIGN KEY (booking_id) REFERENCES bookings (id) | DELETE CASCADE | UPDATE NO ACTION&lt;br&gt;&lt;br&gt;&lt;b&gt;FOREIGN KEY · fk_hotel_bookings_room_type&lt;/b&gt;&lt;br&gt;FOREIGN KEY (room_type_id) REFERENCES hotel_room_types (id) | DELETE NO ACTION | UPDATE NO ACTION&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_hotel_bookings_dates&lt;/b&gt;&lt;br&gt;CHECK (check_out &amp;gt; check_in AND nights &amp;gt; 0)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_hotel_bookings_price&lt;/b&gt;&lt;br&gt;CHECK (price_per_night &amp;gt;= 0)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_hotel_bookings_rooms&lt;/b&gt;&lt;br&gt;CHECK (rooms &amp;gt; 0 AND guests &amp;gt;= rooms)&lt;br&gt;&lt;br&gt;&lt;b&gt;INDEX · idx_hotel_bookings_room_dates&lt;/b&gt;&lt;br&gt;btree (room_type_id, check_in, check_out)" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=12;strokeColor=#7E22CE;fillColor=#F3E8FF;fontColor=#111827;">

        <mxCell id="logical_heading" value="Quan hệ logic M:N (không phải FK trực tiếp)" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=6;fontSize=14;fontSize=17;fontStyle=1;">
          <mxGeometry x="35" y="1715" width="1830" height="32" as="geometry" />
        </mxCell>
        <mxCell id="logical0" value="[R-MN]  users (0..N) ↔ (0..N) roles — qua user_roles (user_id → users.id, role_id → roles.id)" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=6;fontSize=14;fontSize=14;">
          <mxGeometry x="35" y="1750" width="1830" height="35" as="geometry" />
        </mxCell>
        <mxCell id="logical1" value="[R-MN2]  hotels (0..N) ↔ (0..N) amenities — qua hotel_amenities (hotel_id → hotels.id, amenity_id → amenities.id)" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=6;fontSize=14;fontSize=14;">
          <mxGeometry x="35" y="1786" width="1830" height="35" as="geometry" />
        </mxCell>
        <mxCell id="logical2" value="[R-MN3]  hotel_room_types (0..N) ↔ (0..N) amenities — qua hotel_room_type_amenities (room_type_id → hotel_room_types.id, amenity_id → amenities.id)" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=6;fontSize=14;fontSize=14;">
          <mxGeometry x="35" y="1822" width="1830" height="35" as="geometry" />
        </mxCell>
        <mxCell id="note" value="R20: 0..N theo Crow’s Foot nhưng CHECK + UNIQUE giới hạn tối đa 2 chặng (0 và 1). R29–R31: FK cho phép NULL nên đầu A là 0..1 (giao dịch chưa khớp đơn, chưa có nhân viên gắn hoặc xử lý). Mọi quy tắc nghiệp vụ chặt hơn DB và đề xuất Chương 8 không được biểu diễn như FK mới." vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=6;fontSize=14;fontSize=13;">
          <mxGeometry x="35" y="1860" width="1830" height="55" as="geometry" />
        </mxCell>

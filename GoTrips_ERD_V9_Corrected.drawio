        <mxCell id="constraint_tour_departures" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;tour_departures&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;PRIMARY KEY · tour_departures_pkey&lt;/b&gt;&lt;br&gt;PRIMARY KEY (id)&lt;br&gt;&lt;br&gt;&lt;b&gt;FOREIGN KEY · fk_tour_departures_tour&lt;/b&gt;&lt;br&gt;FOREIGN KEY (tour_id) REFERENCES tours (id) | DELETE CASCADE | UPDATE NO ACTION&lt;br&gt;&lt;br&gt;&lt;b&gt;UNIQUE (ghép) · uq_tour_departures_tour_date&lt;/b&gt;&lt;br&gt;UNIQUE (tour_id, departure_date)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_tour_departures_original_price&lt;/b&gt;&lt;br&gt;CHECK (original_price IS NULL OR original_price &amp;gt; 0)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_tour_departures_price&lt;/b&gt;&lt;br&gt;CHECK (price &amp;gt; 0)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_tour_departures_seats&lt;/b&gt;&lt;br&gt;CHECK (total_seats &amp;gt; 0 AND booked_seats &amp;gt;= 0 AND booked_seats &amp;lt;= total_seats)" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=12;strokeColor=#15803D;fillColor=#DCFCE7;fontColor=#111827;">

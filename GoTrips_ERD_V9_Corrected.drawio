        <object id="t_bank_transactions" label="bank_transactions" tooltip="&lt;b&gt;bank_transactions&lt;/b&gt;&lt;br&gt;PRIMARY KEY | bank_transactions_pkey | PRIMARY KEY (id)&lt;br&gt;FOREIGN KEY | fk_bank_transactions_assigned_by | FOREIGN KEY (assigned_by) REFERENCES users (id) | DELETE NO ACTION | UPDATE NO ACTION&lt;br&gt;FOREIGN KEY | fk_bank_transactions_booking | FOREIGN KEY (booking_id) REFERENCES bookings (id) | DELETE NO ACTION | UPDATE NO ACTION&lt;br&gt;FOREIGN KEY | fk_bank_transactions_resolved_by | FOREIGN KEY (resolved_by) REFERENCES users (id) | DELETE NO ACTION | UPDATE NO ACTION&lt;br&gt;UNIQUE | uq_bank_transactions_sepay_id | UNIQUE (sepay_id)&lt;br&gt;CHECK | ck_bank_transactions_amount | CHECK (amount &amp;gt; 0)&lt;br&gt;CHECK | ck_bank_transactions_applied | CHECK (applied_amount &amp;gt;= 0 AND applied_amount &amp;lt;= amount)&lt;br&gt;CHECK | ck_bank_transactions_assignment | CHECK ((assigned_by IS NULL) = (assigned_at IS NULL))&lt;br&gt;CHECK | ck_bank_transactions_booking | CHECK ((booking_id IS NULL) = (outcome IN (&amp;#x27;UNMATCHED&amp;#x27;, &amp;#x27;WRONG_ACCOUNT&amp;#x27;)))&lt;br&gt;CHECK | ck_bank_transactions_outcome | CHECK (outcome IN (&amp;#x27;APPLIED&amp;#x27;, &amp;#x27;OVERPAID&amp;#x27;, &amp;#x27;NOT_PAYABLE&amp;#x27;, &amp;#x27;UNMATCHED&amp;#x27;, &amp;#x27;WRONG_ACCOUNT&amp;#x27;))&lt;br&gt;CHECK | ck_bank_transactions_resolution | CHECK ((resolved_by IS NULL) = (resolved_at IS NULL) AND (resolved_at IS NULL) = (resolution_note IS NULL))&lt;br&gt;CHECK | ck_bank_transactions_sepay_id | CHECK (sepay_id &amp;gt;= 0)&lt;br&gt;INDEX | idx_bank_transactions_booking | btree (booking_id)&lt;br&gt;INDEX | idx_bank_transactions_received | btree (received_at DESC, id DESC)" table="bank_transactions" module="M5" context="false">

        <mxCell id="constraint_bank_transactions" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;bank_transactions&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;PRIMARY KEY · bank_transactions_pkey&lt;/b&gt;&lt;br&gt;PRIMARY KEY (id)&lt;br&gt;&lt;br&gt;&lt;b&gt;FOREIGN KEY · fk_bank_transactions_assigned_by&lt;/b&gt;&lt;br&gt;FOREIGN KEY (assigned_by) REFERENCES users (id) | DELETE NO ACTION | UPDATE NO ACTION&lt;br&gt;&lt;br&gt;&lt;b&gt;FOREIGN KEY · fk_bank_transactions_booking&lt;/b&gt;&lt;br&gt;FOREIGN KEY (booking_id) REFERENCES bookings (id) | DELETE NO ACTION | UPDATE NO ACTION&lt;br&gt;&lt;br&gt;&lt;b&gt;FOREIGN KEY · fk_bank_transactions_resolved_by&lt;/b&gt;&lt;br&gt;FOREIGN KEY (resolved_by) REFERENCES users (id) | DELETE NO ACTION | UPDATE NO ACTION&lt;br&gt;&lt;br&gt;&lt;b&gt;UNIQUE · uq_bank_transactions_sepay_id&lt;/b&gt;&lt;br&gt;UNIQUE (sepay_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bank_transactions_amount&lt;/b&gt;&lt;br&gt;CHECK (amount &amp;gt; 0)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bank_transactions_applied&lt;/b&gt;&lt;br&gt;CHECK (applied_amount &amp;gt;= 0 AND applied_amount &amp;lt;= amount)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bank_transactions_assignment&lt;/b&gt;&lt;br&gt;CHECK ((assigned_by IS NULL) = (assigned_at IS NULL))&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bank_transactions_booking&lt;/b&gt;&lt;br&gt;CHECK ((booking_id IS NULL) = (outcome IN (&amp;#x27;UNMATCHED&amp;#x27;, &amp;#x27;WRONG_ACCOUNT&amp;#x27;)))&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bank_transactions_outcome&lt;/b&gt;&lt;br&gt;CHECK (outcome IN (&amp;#x27;APPLIED&amp;#x27;, &amp;#x27;OVERPAID&amp;#x27;, &amp;#x27;NOT_PAYABLE&amp;#x27;, &amp;#x27;UNMATCHED&amp;#x27;, &amp;#x27;WRONG_ACCOUNT&amp;#x27;))&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bank_transactions_resolution&lt;/b&gt;&lt;br&gt;CHECK ((resolved_by IS NULL) = (resolved_at IS NULL) AND (resolved_at IS NULL) = (resolution_note IS NULL))&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bank_transactions_sepay_id&lt;/b&gt;&lt;br&gt;CHECK (sepay_id &amp;gt;= 0)&lt;br&gt;&lt;br&gt;&lt;b&gt;INDEX · idx_bank_transactions_booking&lt;/b&gt;&lt;br&gt;btree (booking_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;INDEX · idx_bank_transactions_received&lt;/b&gt;&lt;br&gt;btree (received_at DESC, id DESC)" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=12;strokeColor=#7E22CE;fillColor=#F3E8FF;fontColor=#111827;">
          <mxGeometry x="35" y="2724" width="820" height="638" as="geometry" />

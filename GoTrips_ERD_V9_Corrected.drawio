        <mxCell id="constraint_bookings" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;bookings&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;PRIMARY KEY · bookings_pkey&lt;/b&gt;&lt;br&gt;PRIMARY KEY (id)&lt;br&gt;&lt;br&gt;&lt;b&gt;FOREIGN KEY · fk_bookings_user&lt;/b&gt;&lt;br&gt;FOREIGN KEY (user_id) REFERENCES users (id) | DELETE NO ACTION | UPDATE NO ACTION&lt;br&gt;&lt;br&gt;&lt;b&gt;UNIQUE · uq_bookings_code&lt;/b&gt;&lt;br&gt;UNIQUE (code)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bookings_code_format&lt;/b&gt;&lt;br&gt;CHECK (code ~ &amp;#x27;^GT[2-9A-HJKMNP-Z]{6}$&amp;#x27;)&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bookings_kind&lt;/b&gt;&lt;br&gt;CHECK (kind IN (&amp;#x27;TOUR&amp;#x27;, &amp;#x27;HOTEL&amp;#x27;, &amp;#x27;FLIGHT&amp;#x27;))&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bookings_status&lt;/b&gt;&lt;br&gt;CHECK (status IN (&amp;#x27;PENDING&amp;#x27;, &amp;#x27;CONFIRMED&amp;#x27;, &amp;#x27;CANCELLED&amp;#x27;))&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK · ck_bookings_total_amount&lt;/b&gt;&lt;br&gt;CHECK (total_amount &amp;gt;= 0)&lt;br&gt;&lt;br&gt;&lt;b&gt;INDEX · idx_bookings_created&lt;/b&gt;&lt;br&gt;btree (created_at DESC, id DESC)&lt;br&gt;&lt;br&gt;&lt;b&gt;INDEX · idx_bookings_status_created&lt;/b&gt;&lt;br&gt;btree (status, created_at DESC, id DESC)&lt;br&gt;&lt;br&gt;&lt;b&gt;INDEX · idx_bookings_user_created&lt;/b&gt;&lt;br&gt;btree (user_id, created_at DESC, id DESC)" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=12;strokeColor=#7E22CE;fillColor=#F3E8FF;fontColor=#111827;">
